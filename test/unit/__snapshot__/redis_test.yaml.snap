  28: |
    apiVersion: monitoring.coreos.com/v1
    kind: PrometheusRule
    metadata:
      labels:
        app: redis
        chart: redis-0.0.9
        heritage: Helm
        release: instance
      name: instance-redis
      namespace: NAMESPACE
    spec:
      groups:
        - name: redis-rules
          rules:
            - alert: RedisDown
              annotations:
                message: Redis instance {{ $labels.pod }} is down
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/redis/RedisDown.html
              expr: |
                redis_up{service="redis-metrics"} == 0
              for: 2m
              labels:
                audience: service_operator
                severity: critical
            - alert: RedisClusterDown
              annotations:
                message: Redis cluster {{ $labels.instance }} is down
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/redis/RedisClusterDown.html
              expr: |
                (
                  sum by(namespace) (redis_up{service="redis"}) < 1
                  or
                  sum by(namespace) (kube_statefulset_status_replicas_ready{statefulset="redis-server"}) < 1
                )
                and on(namespace)
                kube_statefulset_replicas{statefulset="redis-server"} > 0
              for: 5m
              labels:
                audience: service_operator
                severity: critical
            - alert: RedisMasterCountIssue
              annotations:
                message: Redis cluster does not have exactly one master node.
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/redis/RedisMasterMissing.html
              expr: |
                sum by (namespace) (redis_instance_info{role="master"} != 1)
              for: 5m
              labels:
                audience: service_operator
                severity: critical
            - alert: RedisDisconnectedSlaves
              annotations:
                message: Redis not replicating for all slaves. Consider reviewing the redis replication status.
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/redis/RedisDisconnectedSlaves.html
              expr: |
                count without (instance, job) (redis_connected_slaves) - sum without (instance, job) (redis_connected_slaves) - 1 > 1
              for: 5m
              labels:
                audience: service_operator
                severity: critical
            - alert: RedisReplicationBroken
              annotations:
                message: Redis instance {{ $labels.pod }} lost a slave.
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/redis/RedisReplicationBroken.html
              expr: |
                delta(redis_connected_slaves[1m]) < 0
              for: 5m
              labels:
                audience: service_operator
                severity: critical
            - alert: RedisClusterFlapping
              annotations:
                message: Changes have been detected in Redis replica connection. This can occur when replica nodes lose connection to the master and reconnect (a.k.a flapping).
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/redis/RedisClusterFlapping.html
              expr: |
                changes(redis_connected_slaves[15m]) > 2
              for: 1h
              labels:
                audience: service_operator
                severity: critical
            - alert: RedisMasterLinkDown
              annotations:
                message: Redis instance {{ $labels.pod }} had no link to the master for the last 5 minutes.
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/redis/RedisMasterLinkDown.html
              expr: |
                max without(instance, master_host) (redis_master_link_up) != 1
              for: 5m
              labels:
                audience: service_operator
                severity: warning
