      serviceName: redis
      template:
        metadata:
          annotations:
            checksum/init-config: d5f7e655f7b68db0cc311596a66434b1016c93783fe497dc4e6460e4fdd71583
            k8up.io/backupcommand: sh /scripts/backup.sh
            k8up.io/file-extension: .tar
          labels:
            app: redis
            redis: replica
            release: instance
        spec:
          affinity:
            podAntiAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                - labelSelector:
                    matchLabels:
                      app: redis
