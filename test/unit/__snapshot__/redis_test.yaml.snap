            - namespaceSelector:
                matchLabels:
                  helmetica.io/monitoring: system
      podSelector: {}
      policyTypes:
        - Ingress
  6: |
    apiVersion: v1
    data:
      backup.sh: |
        #!/bin/sh

        REDIS_PASSWORD=$AUTH

        redis_cmd() {
          redis-cli -a "${REDIS_PASSWORD}" "$@"
        }

        rewrite_percentage=$(redis_cmd --raw CONFIG GET auto-aof-rewrite-percentage | tail -n 1) 1>&2

        redis_cmd CONFIG SET auto-aof-rewrite-percentage 0 1>&2

        redis_cmd SAVE 1>&2

        until redis_cmd INFO persistence | grep aof_rewrite_in_progress:0 > /dev/null
        do
          sleep 1
        done

        tar -cf - /data

        redis_cmd CONFIG SET auto-aof-rewrite-percentage "${rewrite_percentage}" 1>&2
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: instance
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: redis
        helm.sh/chart: redis-0.0.9
      name: backup
  7: |
    apiVersion: arcana.helmetica.io/v1
    kind: Arcanum
    metadata:
      labels:
        app.kubernetes.io/instance: instance
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: redis
        helm.sh/chart: redis-0.0.9
      name: credentials
    spec:
      credentials:
        valueMapping:
          REDIS_EXTERNAL_HOST:
            apiVersion: seals.helmetica.io/v1
            kind: Seal
            name: networkconfig
            path: '{.status.exposures[?(@.name=="redis")].address}'
            source: objectRef
          REDIS_EXTERNAL_PORT:
            apiVersion: seals.helmetica.io/v1
            kind: Seal
            name: networkconfig
            path: '{.status.exposures[?(@.name=="redis")].port}'
            source: objectRef
          REDIS_EXTERNAL_URL:
            source: template
            value: redis://{{.REDIS_USERNAME}}:{{.REDIS_PASSWORD}}@{{.REDIS_EXTERNAL_HOST}}:{{.REDIS_EXTERNAL_PORT}}
          REDIS_HOST:
            source: template
            value: redis-haproxy.{{.InstanceNamespace}}.svc.cluster.local
          REDIS_MASTER_GROUP_NAME:
            source: const
            value: mymaster
          REDIS_PASSWORD:
            key: auth
            kind: Secret
            name: instance-auth
            source: objectRef
          REDIS_PORT:
            source: const
            value: "6379"
          REDIS_SENTINEL_HOST:
            source: template
            value: redis.{{.InstanceNamespace}}.svc.cluster.local
          REDIS_SENTINEL_PORT:
            source: const
            value: "26379"
          REDIS_URL:
            source: template
            value: redis://{{.REDIS_USERNAME}}:{{.REDIS_PASSWORD}}@{{.REDIS_HOST}}:{{.REDIS_PORT}}
          REDIS_USERNAME:
            source: const
            value: default
      target:
        name: instance-credentials
  8: |
    apiVersion: rituals.helmetica.io/v1
    kind: Definition
    metadata:
      labels:
        app.kubernetes.io/instance: instance
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: redis
        helm.sh/chart: redis-0.0.9
      name: restart
    spec:
      description: Restart the application
      jobTemplate:
        spec:
          template:
            spec:
              containers:
                - args:
                    - rollout
                    - restart
                    - statefulset/redis-server
                  command:
                    - kubectl
                  image: registry.k8s.io/kubectl:v1.34.1
                  name: restart
              restartPolicy: Never
renders in ha:
  1: |
    raw: |
      Redis can be accessed via port 6379   and Sentinel can be accessed via port 26379    on the following DNS name from within your cluster:
      redis.NAMESPACE.svc.cluster.local

      To connect to your Redis server:
      1. To retrieve the redis password:
         echo $(kubectl get secret redis -o "jsonpath={.data['auth']}" | base64 --decode)

      2. Connect to the Redis master pod that you can use as a client. By default the redis-server-0 pod is configured as the master:

         kubectl exec -it redis-server-0 -n NAMESPACE -c redis -- sh

      3. Connect using the Redis CLI (inside container):

         redis-cli -a <REDIS-PASS-FROM-SECRET>
  2: |
    apiVersion: v1
    kind: Service
    metadata:
      annotations: null
