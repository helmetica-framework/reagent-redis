          rules:
            - alert: RedisDown
              annotations:
                message: Redis instance {{ $labels.pod }} is down
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/redis/RedisDown.html
              expr: |
                redis_up{service="redis-metrics"} == 0
              for: 2m
