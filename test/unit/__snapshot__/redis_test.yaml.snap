              env:
                - name: AUTH
                  valueFrom:
                    secretKeyRef:
                      key: auth
                      name: instance-auth
              image: public.ecr.aws/docker/library/redis:8.8.0-alpine
              imagePullPolicy: IfNotPresent
              lifecycle:
                preStop:
                  exec:
                    command:
                      - /bin/sh
                      - /readonly-config/trigger-failover-if-master.sh
              livenessProbe:
                exec:
                  command:
                    - sh
