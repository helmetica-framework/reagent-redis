{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions dependencies",
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "prCreation": "not-pending",
      "internalChecksFilter": "strict"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions in Justfiles annotated with a `# renovate:` comment",
      "managerFilePatterns": [
        "/(^|/)Justfile$/",
        "/\\.just$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: registryUrl=(?<registryUrl>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\n[A-Z0-9_]+ := \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Update the pinned images in values.yaml and templates annotated with a `# renovate:` comment",
      "managerFilePatterns": [
        "/(^|/)values\\.yaml$/",
        "/(^|/)templates/.+\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\n\\s*[^\\s:]+: (?:\\S+:)?(?<currentValue>[^@\\s:]+)@(?<currentDigest>sha256:[0-9a-f]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the just version used to bootstrap CI",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)\\n\\s*just-version: '(?<currentValue>[^']+)'"
      ]
    }
  ]
}
